{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["athena:*"], "Resource": "*" },
    { "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetDatabases", "glue:GetTable", "glue:GetTables",
                 "glue:CreateTable", "glue:UpdateTable", "glue:GetPartitions", "glue:BatchCreatePartition"],
      "Resource": "*" },
    { "Effect": "Allow", "Action": ["lakeformation:GetDataAccess"], "Resource": "*" },
    { "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:DeleteObject", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::arun-lakehouse-curated", "arn:aws:s3:::arun-lakehouse-curated/*",
        "arn:aws:s3:::arun-lakehouse-athena-results", "arn:aws:s3:::arun-lakehouse-athena-results/*"
      ] }
  ]
}
